    {"id": "r6-constant-flag", "recipe": "R6", "file": "src/pricing.cpp", "legacy_pattern": "kUseTieredDiscounts", "description": "runtime flag hard-wired to true with an unreachable else"},
    {"id": "r6-if-zero", "recipe": "R6", "file": "src/pricing.cpp", "legacy_pattern": "#if 0", "description": "#if 0 block"},
    {"id": "r6-unused-static", "recipe": "R6", "file": "src/pricing.cpp", "legacy_pattern": "legacy_round_cents", "description": "unused internal-linkage function (tier 1: safe to delete)"},
    {"id": "r6-unused-include", "recipe": "R6", "file": "src/pricing.cpp", "legacy_pattern": "#include <map>", "description": "unused include"},
    {"id": "r6-unused-public", "recipe": "R6", "file": "include/inventory/pricing.h", "legacy_pattern": "legacy_flat_tax", "description": "unreferenced function in a public header (tier 2: report, delete only if API changes are allowed)"}
  ]
