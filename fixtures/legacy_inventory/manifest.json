    {"id": "r5-snprintf", "recipe": "R5", "file": "src/item.cpp", "legacy_pattern": "\\bsnprintf\\(", "description": "fixed buffer + snprintf instead of std::format"},
    {"id": "r5-pointer-length", "recipe": "R5", "file": "include/inventory/util.h", "legacy_pattern": "const (int|double)\\* data, size_t count", "description": "pointer + length pair instead of std::span"},
    {"id": "r5-starts-with", "recipe": "R5", "file": "src/util.cpp", "legacy_pattern": "text\\.compare\\(0,", "description": "hand-rolled prefix check instead of starts_with"},

